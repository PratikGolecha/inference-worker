name: Build and Push to GHCR (Manual)

on:
  workflow_dispatch:  # Only manual trigger - GitHub Actions cannot build CUDA images
    inputs:
      tags:
        description: 'Docker image tags (comma-separated, e.g., latest,v0.1.0)'
        required: false
        default: 'latest'

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    
    permissions:
      contents: read
      packages: write
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Build and push Docker image (CPU-only fallback)
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            ghcr.io/${{ github.repository }}:cpu-fallback
          build-args: |
            CUDA_AVAILABLE=false
          labels: |
            org.opencontainers.image.source=https://github.com/${{ github.repository }}
            org.opencontainers.image.description=CPU-only fallback (GitHub Actions cannot build CUDA images)
      
      - name: Warning
        run: |
          echo "⚠️ This is a CPU-only fallback build!"
          echo "For CUDA/TurboQuant support, build locally and push:"
          echo "  docker build -t ghcr.io/${{ github.repository }}:latest ."
          echo "  docker push ghcr.io/${{ github.repository }}:latest"
